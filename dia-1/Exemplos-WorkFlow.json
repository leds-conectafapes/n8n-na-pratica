    {
      "parameters": {
        "jsCode": "// Pega a lista de previsões do primeiro item\nlet lista = $input.first().json.list;\nlet dadosProcessados = [];\n\n// Loop através de cada item da lista\nfor (const item of lista) {\n  let dados = {\n    // Temperatura (convertendo de Kelvin para Celsius)\n    temperatura: {\n      atual: item.main?.temp ? Math.round(item.main.temp - 273.15) : null,\n      maxima: item.main?.temp_max ? Math.round(item.main.temp_max - 273.15) : null,\n      minima: item.main?.temp_min ? Math.round(item.main.temp_min - 273.15) : null,\n      sensacao_termica: item.main?.feels_like ? Math.round(item.main.feels_like - 273.15) : null\n    },\n\n    // Condições climáticas\n    clima: {\n      principal: item.weather?.[0]?.main || null,\n      descricao: item.weather?.[0]?.description || null,\n      id_condicao: item.weather?.[0]?.id || null,\n      icone: item.weather?.[0]?.icon || null\n    },\n\n    // Pressão atmosférica\n    pressao: {\n      nivel_mar: item.main?.sea_level || null,\n      nivel_solo: item.main?.grnd_level || null,\n      pressao_geral: item.main?.pressure || null\n    },\n\n    // Umidade e visibilidade\n    atmosfera: {\n      umidade: item.main?.humidity || null,\n      visibilidade: item.visibility || null,\n      nuvens_cobertura: item.clouds?.all || null\n    },\n\n    // Vento\n    vento: {\n      velocidade: item.wind?.speed || null,\n      direcao_graus: item.wind?.deg || null,\n      rajada: item.wind?.gust || null\n    },\n\n    // Informações de sistema e tempo\n    sistema: {\n      periodo_dia: item.sys?.pod || null, // 'd' para dia, 'n' para noite\n      data_hora_previsao: item.dt_txt || null,\n      timestamp: item.dt || null\n    },\n\n    // Informações adicionais\n    extras: {\n      temp_kf: item.main?.temp_kf || null // Correção de temperatura interna\n    }\n  };\n\n  dadosProcessados.push(dados);\n}\n\n// Retorna array com todos os dados processados\nreturn dadosProcessados.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
